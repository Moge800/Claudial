# Claudial Daemon 設定ファイル
# このファイルを .env にコピーして編集してください

# BLE デバイス名（ファームウェアの DEVICE_NAME と合わせる）
# CLAUDIAL_DEVICE_NAME=Claudial

# 使用量ポーリング間隔（秒）
# CLAUDIAL_POLL_INTERVAL=60

# BLE スキャンタイムアウト（秒）
# CLAUDIAL_SCAN_TIMEOUT=15

# daemon.log の上限（MB）。超えたら daemon.log.1 に退避（古い世代は1つだけ）
# CLAUDIAL_LOG_MAX_MB=5
